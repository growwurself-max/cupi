# Cupi API
PORT=5000

# The frontend origin(s) allowed by CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173

# FamGateway UPI Payment Gateway — Backend (Render & .env)
# Server-side only. NEVER expose this in a VITE_ variable (frontend-visible).
FAMGATEWAY_API_KEY=

# Public backend origin used for the FamGateway webhook URL. Override when the
# API is not deployed to the default Render host.
BACKEND_URL=https://cupi-psmr.onrender.com

# PERMANENT SHAREABLE LINKS — Supabase (free tier), required in production.
# Every order and every generated website lives here, so /x/:id links survive
# deploys, restarts and free-tier spin-downs. Set both values in Render.
# The service-role key is server-side only: NEVER commit it and NEVER put it in
# a VITE_ variable (those are shipped to the browser). Rotate it in the Supabase
# dashboard if it is ever exposed.
# Project URL: Supabase dashboard -> Project Settings -> Data API
# Key:        Supabase dashboard -> Project Settings -> API Keys -> service_role
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Apply supabase/schema.sql in the SQL Editor before first use, then run
# `npm run migrate-data` to move any existing db.json records across.

# Local development only: where db.json is read/written when Supabase is not
# configured. Production refuses to start without Supabase, so this can never
# silently fall back to an ephemeral disk.
CUPI_DATA_DIR=

# Production frontend (overrides FRONTEND_URL above in prod)
FRONTEND_URL=https://cupi-one.vercel.app

# Frontend (Vercel & .env)
VITE_API_URL=https://cupi-psmr.onrender.com/api

# Super Admin
#
# 1) Dashboard login form (POST /api/admin/login), page at /admin/dashboard.
#    SUPER_ADMIN_EMAIL is the login identifier - a username or an email address.
#    Both are read from the environment only; never commit real values here.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# 2) Static Bearer token still accepted directly by every /api/admin route
#    (scripts, curl, existing tooling) and used to sign dashboard sessions.
#    Generate one with: openssl rand -hex 32
SUPER_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Customer authentication (Login / Sign Up on the Cupi storefront)
# ---------------------------------------------------------------------------
# Re-runs of supabase/schema.sql create cupi_customers + cupi_auth_tokens.
# Without those tables the auth endpoints answer 503 (checkout, share links
# and the Superadmin are unaffected).

# Signs customer session tokens (POST /api/auth/*). Generate with:
#   openssl rand -hex 32
# Falls back to SUPER_ADMIN_TOKEN when unset, but a dedicated secret is safer.
CUSTOMER_AUTH_SECRET=

# Google OAuth — "Continue with Google".
# Console: https://console.cloud.google.com/apis/credentials -> OAuth client (Web).
# Authorise these origins for the same client:
#   http://localhost:5173   (local dev)
#   https://cupi-one.vercel.app (production)
# The same value goes in BOTH variables: the backend verifies the ID token
# against GOOGLE_CLIENT_ID, the frontend renders the button with the VITE_ one.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Outgoing e-mail (verification + password reset) through Resend.
# Keys: https://dashboard.resend.com/api-keys  — verified domain in:
#   https://dashboard.resend.com/domains
# Leave RESEND_API_KEY empty to run without e-mail: signup/login still work and
# the links are printed in the server log instead of being sent.
RESEND_API_KEY=
EMAIL_FROM=Cupi <onboarding@resend.dev>
