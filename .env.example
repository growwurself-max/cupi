# Cupi API
PORT=5000

# The frontend origin(s) allowed by CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173

# Razorpay keys — test mode keys start with rzp_test_
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# Optional: override the API base used by the frontend.
# Leave unset to use the Vite dev proxy (same-origin /api).
VITE_API_URL=http://localhost:5000/api