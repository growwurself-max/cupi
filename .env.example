# Cupi API
PORT=5000

# The frontend origin(s) allowed by CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173

# FamGateway UPI Payment Gateway — Backend (Render & .env)
# Server-side only. NEVER expose this in a VITE_ variable (frontend-visible).
FAMGATEWAY_API_KEY=

# Public backend origin used for the FamGateway webhook URL. Override when the
# API is not deployed to the default Render host.
BACKEND_URL=https://cupi-psmr.onrender.com

# PERMANENT SHAREABLE LINKS — Supabase (free tier), required in production.
# Every order and every generated website lives here, so /x/:id links survive
# deploys, restarts and free-tier spin-downs. Set both values in Render.
# The service-role key is server-side only: NEVER commit it and NEVER put it in
# a VITE_ variable (those are shipped to the browser). Rotate it in the Supabase
# dashboard if it is ever exposed.
# Project URL: Supabase dashboard -> Project Settings -> Data API
# Key:        Supabase dashboard -> Project Settings -> API Keys -> service_role
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Apply supabase/schema.sql in the SQL Editor before first use, then run
# `npm run migrate-data` to move any existing db.json records across.

# Local development only: where db.json is read/written when Supabase is not
# configured. Production refuses to start without Supabase, so this can never
# silently fall back to an ephemeral disk.
CUPI_DATA_DIR=

# Production frontend (overrides FRONTEND_URL above in prod)
FRONTEND_URL=https://cupi-one.vercel.app

# Frontend (Vercel & .env)
VITE_API_URL=https://cupi-psmr.onrender.com/api

# Super Admin
# Secret token required to access the admin dashboard and API endpoints.
# Set a strong, random secret in production. Never commit this to version control.
SUPER_ADMIN_TOKEN=