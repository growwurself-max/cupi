# Cupi API
PORT=5000

# The frontend origin(s) allowed by CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173

# FamGateway UPI Payment Gateway — Backend (Render & .env)
# Server-side only. NEVER expose this in a VITE_ variable (frontend-visible).
FAMGATEWAY_API_KEY=

# Public backend origin used for the FamGateway webhook URL. Override when the
# API is not deployed to the default Render host.
BACKEND_URL=https://cupi-psmr.onrender.com

# PERMANENT SHAREABLE LINKS — required in production.
# db.json holds every order and every generated website, so it MUST live on a
# persistent volume. Point this at a mounted disk (Render: attach a persistent
# disk and mount it at e.g. /var/data, then set CUPI_DATA_DIR=/var/data).
# Left unset, the records sit on the instance's local disk, which is wiped on
# every deploy, restart and free-tier spin-down — that is what made already
# shared /x/:id links stop working after a while. Leave unset for local dev.
CUPI_DATA_DIR=

# Production frontend (overrides FRONTEND_URL above in prod)
FRONTEND_URL=https://cupi-one.vercel.app

# Frontend (Vercel & .env)
VITE_API_URL=https://cupi-psmr.onrender.com/api